# 在 apps/client 目录复制为 .env.local；这些配置只包含公开地址和地图格式参数。
VITE_API_BASE_URL=/monopoly-api
VITE_BACKEND_URL=https://192.168.1.3:7443
VITE_DEV_PROXY_CA_FILE=../../../GameBackend/tools/dev/classic-wss/local/classic-sit-server.pem
VITE_PEER_SERVER_URL=/monopoly-mine-peer
VITE_PEER_PROXY_TARGET=http://127.0.0.1:9003
VITE_PEER_SERVER_KEY=monopoly-mine
VITE_GAME_ADMIN_URL=http://localhost:7111
VITE_WEB_BASE_PATH=/monopoly/
# .mmmap 由编辑器选择的格式密码；留空只支持未加密格式。
VITE_MAP_ENCRYPT_KEY=
