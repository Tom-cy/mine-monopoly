# 线上 Web 构建配置；build:web 使用 vite build --mode web，自动加载本文件。
# 对应 GameBackend/docker-prod/deploy/nginx/conf.d/game.conf。
# 访问入口：https://game.iskaola.com/play/；/play/ 只用于静态资源和前端路由。
VITE_WEB_BASE_PATH=/play/
# 同源请求由 NGINX 转发，不把 Java / PeerServer 的内部端口暴露给浏览器。
VITE_API_BASE_URL=/monopoly-api
VITE_PEER_SERVER_URL=/monopoly-mine-peer
VITE_PEER_SERVER_KEY=monopoly-mine

# 公开 .mmmap 格式参数，浏览器可见；须与线上地图发布时的原文一致，恰好 16 个 UTF-8 字节。
VITE_MAP_ENCRYPT_KEY="😀你好abc123"
